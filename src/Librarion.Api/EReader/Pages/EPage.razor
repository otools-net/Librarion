@*
    The frame of every e-reader page (D-8.1): plain HTML, one stylesheet, no script; the app's name as the way home,
    and for a signed-in account its name and a Sign out button (a form: GET never changes anything, D-8.4); signed in
    by a key in the address (D-8.7), nothing to sign out of.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title – @Texts["app.name"]</title>
    <link rel="stylesheet" href="@Frame.Links.Stylesheet">
</head>
<body>
<header class="top">
    <a class="brand" href="@Frame.Links.Home">@Texts["app.name"]</a>
    @if (Frame is { UserName: { } name, Token: { } token, Links.ByKey: false })
    {
        <form class="account" method="post" action="@Frame.Links.SignOut">
            <FormToken Token="token" />
            <span class="muted">@name</span>
            <button type="submit">@Texts["account.signOut"]</button>
        </form>
    }
</header>
<main>
    @if (Up is { } up)
    {
        <p class="crumb"><a href="@up.Href">@up.Text</a></p>
    }
    <h1>@Title</h1>
    @ChildContent
</main>
</body>
</html>

@code {
    [Parameter, EditorRequired] public EReaderFrame Frame { get; set; } = null!;

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The page this one is under (a library for its lists), linked above the heading.</summary>
    [Parameter] public Crumb? Up { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    public sealed record Crumb(string Text, string Href);
}
