@using System.Globalization
@using Librarion.Core.Catalog
@*
    The one list of books (D-8.6): a small cover (the s thumbnail at 48 x 72, its size set so the page doesn't move
    while it loads), the title (the file's name for a book without one), authors, series and number. Each row is one
    link to the book's page.
*@
@if (Books.Count == 0)
{
    <p class="muted">@Texts["ereader.list.empty"]</p>
}
else
{
    <ul class="plain books">
        @foreach (var book in Books)
        {
            <li>
                <a href="@Frame.Links.Book(book.LibraryId, book.Id)">
                    <img class="cover" src="@Frame.Links.Cover(book.LibraryId, book.Id, "s", book.CoverVersion)" width="48" height="72" alt="">
                    <span class="about">
                        <span class="title">@Texts.BookTitle(book.Title, book.FileName)</span>
                        @if (book.Authors.Count > 0)
                        {
                            <span class="authors">@string.Join(", ", book.Authors)</span>
                        }
                        @if (book.Series is { } series)
                        {
                            <span class="series">@SeriesOf(series, book.SeriesNumber)</span>
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public EReaderFrame Frame { get; set; } = null!;

    [Parameter, EditorRequired] public IReadOnlyList<BookListItem> Books { get; set; } = [];

    private string SeriesOf(string series, double? number) => number is { } n
        ? Texts.Format("ereader.book.seriesNumber", ("series", series), ("number", n.ToString("0.##", CultureInfo.InvariantCulture)))
        : series;
}
