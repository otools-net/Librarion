@using Librarion.Core.Catalog
@*
    A library's page (the home page when it is the only one): its search box, the books added last, and what it can be
    browsed by (all books A to Z, each field with values, the plain tags).
*@
<EPage Frame="Frame" Title="@Name">
    <SearchBox Frame="Frame" LibraryId="LibraryId" />

    <h2>@Texts["ereader.library.recent"]</h2>
    <BookList Frame="Frame" Books="Recent" />
    @if (MoreRecent)
    {
        <p class="more"><a href="@Frame.Links.Recent(LibraryId)">@Texts["ereader.library.moreRecent"]</a></p>
    }

    <h2>@Texts["ereader.library.browse"]</h2>
    <ul class="plain">
        <li><a href="@Frame.Links.Titles(LibraryId)">@Texts["ereader.library.titles"]</a></li>
        @foreach (var field in Fields)
        {
            <li><a href="@Frame.Links.Field(LibraryId, field.Key)">@Texts.FieldName(field.Key, field.Name, field.BuiltIn)</a></li>
        }
        <li><a href="@Frame.Links.Tags(LibraryId)">@Texts["shell.nav.tags"]</a></li>
    </ul>
</EPage>

@code {
    [Parameter, EditorRequired] public EReaderFrame Frame { get; set; } = null!;

    [Parameter, EditorRequired] public int LibraryId { get; set; }

    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter, EditorRequired] public IReadOnlyList<BookListItem> Recent { get; set; } = [];

    /// <summary>More books than <see cref="Recent"/> shows: a link to all of them.</summary>
    [Parameter] public bool MoreRecent { get; set; }

    /// <summary>The fields that hold values in the tenant (authors, series…), in the app's order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<FieldInfo> Fields { get; set; } = [];
}
