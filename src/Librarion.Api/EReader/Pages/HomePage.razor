@*
    The home page with several libraries to browse: the list of them (with one, EReaderEndpoints shows its page here
    instead).
*@
<EPage Frame="Frame" Title="@(Texts["ereader.home.libraries"])">
    @if (Libraries.Count > 0)
    {
        <ul class="plain">
            @foreach (var library in Libraries)
            {
                <li><a href="@library.Href">@library.Name</a></li>
            }
        </ul>
    }
    else
    {
        <p class="muted">@Texts["ereader.home.noLibraries"]</p>
    }
</EPage>

@code {
    [Parameter, EditorRequired] public EReaderFrame Frame { get; set; } = null!;

    /// <summary>The libraries the account may browse, in the app's order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LibraryLink> Libraries { get; set; } = [];

    public sealed record LibraryLink(string Name, string Href);
}
