# Copy to .env next to docker-compose.yml and fill in (docs/docker.md). .env is never committed.

# The address it will have: a domain or subdomain whose DNS points at Traefik.
LIBRARION_DOMAIN=books.example.com

# The folder of your books on this machine (mounted read-only as /books).
LIBRARION_BOOKS=/srv/books

# The code the setup page asks for on the first start, at least 12 characters.
LIBRARION_SETUP_CODE=

# The database's password (a long random one: `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# The image tag: edge (the work not released yet), main, latest (the last release) or a version like 0.9.0.
LIBRARION_TAG=edge

# Traefik: its Docker network, its https entry point and its certificate resolver, as named in its configuration.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# The addresses Traefik may have, whose X-Forwarded-For is believed (default: Docker's ranges, 172.16.0.0/12).
# LIBRARION_TRUSTED_PROXIES=172.18.0.0/16
